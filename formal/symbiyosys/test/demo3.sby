[options]
depth 10
mode bmc

[engines]
smtbmc boolector

[script]
read_verilog -formal -sv demo.v
prep -top top

[file demo.v]
module top (
  input clk
);
  reg [7:0] counter = 0;

  always @(posedge clk) begin
    counter <= counter + 1;
  end

  always @* begin
    // an unsigned counter can never be negative
    assert (counter >= 0);
  end
endmodule
